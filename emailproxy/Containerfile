# email-oauth2-proxy: transparent XOAUTH2 bridge so Home Assistant's imap
# integration (no OAuth support) can watch Gmail label folders without an app
# password. HA connects to this proxy on the LAN; the proxy speaks IMAPS with
# OAuth to imap.gmail.com.
#
# Built from a pinned commit of this repo by the mise `projects:sync` task
# (see ~/.config/mise/conf.d/homelab.toml); runs as a long-lived quadlet
# .container unit.
#
# Mounts:
#   /config/emailproxy.config  static config: servers + OAuth client (secret,
#                              lives in yadm git-crypt)
#   /data                      mutable token cache (--cache-store) and debug
#                              logs; plain local dir, NOT in yadm
FROM docker.io/library/python:3.13-slim

# renovate: datasource=pypi depName=emailproxy
ARG EMAILPROXY_VERSION=2026.7.3
RUN pip install --no-cache-dir emailproxy==${EMAILPROXY_VERSION}

ENTRYPOINT ["python", "-m", "emailproxy", "--no-gui", \
    "--config-file", "/config/emailproxy.config", \
    "--cache-store", "/data/credstore.config"]
# First-time account authorisation: append --local-server-auth and publish
# port 8080, then follow the URL the proxy logs when a client first connects.
