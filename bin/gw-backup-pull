#!/usr/bin/env bash
# Pull small config backups from the UDM-SE into the yadm-managed gw-config
# dir. Committing is left to the operator: changes show up in yadm status.
set -euo pipefail
G=$HOME/.config/gw-config/backups

rsync -rtq gw:/data/unifi/data/backup/autobackup/ "$G/unifi/" 2>/dev/null
# alice is the adguardhome-sync origin (source of truth); bob's yaml is
# sync-derived but cheap to keep for whole-instance restores.
rsync -tq gw:/data/adguard-alice/AdGuardHome.yaml \
    "$G/adguard-alice/AdGuardHome.yaml" 2>/dev/null
rsync -tq gw:/data/adguard-bob/AdGuardHome.yaml \
    "$G/adguard-bob/AdGuardHome.yaml" 2>/dev/null
ssh gw 'du -sh /data/custom/machines/* 2>/dev/null; echo
    machinectl list --no-legend; echo
    echo "--- versions ---"
    ubnt-device-info summary 2>/dev/null | grep Firmware
    /data/custom/machines/caddy/usr/bin/caddy version 2>/dev/null | sed "s/^/caddy: /"
    /data/custom/machines/adguard-alice/opt/AdGuardHome/AdGuardHome --version 2>/dev/null
    grep -h PRETTY /data/custom/machines/*/etc/os-release 2>/dev/null' \
    2>/dev/null > "$G/machines-manifest.txt"

echo "pulled: $(ls "$G/unifi" | grep -c '\.unf$') unf backups, adguard yamls, machines manifest"
