#!/usr/bin/env bash
# Continuous reachability probe for services fronted by the gateway's caddy
# (*.lan.ucw.phd -> aetf-arch-homelab), with packet capture on the first
# failure. Exists because a caddy 502 ("dial tcp ...: i/o timeout") against a
# healthy backend leaves no trace on either host: the drop happens inside the
# gateway. Known cause (2026-09-13, caught by this capture): UniFi Threat
# Management in IPS mode matched a "Web Infrastructure Servers" signature on
# the homelab's HTTP responses and put the caddy<->homelab tuple into the
# `ips` ipset for 300s; each expiry let one connection through, which
# re-triggered the block (<=5s of service per 300s). Anything else that eats
# SYNs on the gateway shows up the same way, so on failure this records:
#   vb-caddy  - what the caddy container emits / gets back
#   br0       - what the gateway forwards toward the homelab / gets back
#   gw-state  - IPS block set, neighbour, bridge fdb, conntrack for the tuple
# A SYN on vb-caddy that never shows on br0 is the gateway dropping it (check
# gw-state for an `ips` entry first); a SYN on br0 with no SYN-ACK is the
# homelab or the switch.
#
# Runs as a long-lived user service; state changes go to the journal
# (`journalctl --user -u lan-proxy-probe`), captures to $CAPTURE_DIR.
set -uo pipefail

INTERVAL=${INTERVAL:-10}
CAPTURE_DIR=${CAPTURE_DIR:-$HOME/.local/state/lan-proxy-probe}
CAPTURE_SECS=12
CAPTURE_MIN_GAP=300   # seconds between captures; a long outage is one event
HOMELAB_IP=192.168.80.238

# name -> URL. Any HTTP answer from the backend counts as reachable (bt answers
# 403 to unauthenticated remote clients); 502/503/504 is caddy failing to reach
# it; 000 is curl failing to reach caddy at all (a different hop).
declare -A TARGETS=(
    [spool]=https://spool.lan.ucw.phd/api/v1/info
    [bt]=https://bt.lan.ucw.phd/api/v2/app/webapiVersion
)
PORTS="tcp port 8000 or tcp port 9876"

mkdir -p "$CAPTURE_DIR"
declare -A state failed_since
last_capture=0

probe() {
    local code
    code=$(curl -s -o /dev/null -w '%{http_code}' -m 4 "$1" 2>/dev/null)
    [[ $code =~ ^[0-9]{3}$ ]] && echo "$code" || echo 000
}

capture() {
    local ts t; ts=$(date +%Y%m%dT%H%M%S)
    local base="$CAPTURE_DIR/$ts"
    echo "capturing ${CAPTURE_SECS}s on gw -> $base.{br0,vb-caddy}.pcap"
    ssh -o BatchMode=yes -o ConnectTimeout=5 gw \
        "timeout $CAPTURE_SECS tcpdump -ni br0 -U -w - 'host $HOMELAB_IP and ($PORTS)'" \
        >"$base.br0.pcap" 2>"$base.br0.err" &
    ssh -o BatchMode=yes -o ConnectTimeout=5 gw \
        "timeout $CAPTURE_SECS tcpdump -ni vb-caddy -U -w - 'host $HOMELAB_IP and ($PORTS)'" \
        >"$base.vb-caddy.pcap" 2>"$base.vb-caddy.err" &
    # State that would explain a drop, taken while it is happening.
    ssh -o BatchMode=yes -o ConnectTimeout=5 gw bash -s >"$base.gw-state.txt" 2>&1 <<EOF &
date -Is
echo '## ips ipset (Threat Management blocks)'; ipset list ips | sed -n '/Members/,\$p'
echo '## fdb'; bridge fdb show | grep -i "\$(ip neigh show $HOMELAB_IP | awk '{print \$5}')"
echo '## neigh'; ip neigh show $HOMELAB_IP
echo '## conntrack'; conntrack -L -d $HOMELAB_IP 2>/dev/null | grep -E '8000|9876' | tail -20
EOF
    # Drive traffic through caddy while the sniffers run.
    sleep 1
    for _ in 1 2 3; do
        for t in "${TARGETS[@]}"; do probe "$t" >/dev/null; done
        sleep 3
    done
    wait
    echo "capture done: $(ls "$base".*.pcap | xargs -n1 basename | tr '\n' ' ')"
}

echo "probing ${!TARGETS[*]} every ${INTERVAL}s via the gateway caddy"
while :; do
    now=$(date +%s)
    for name in "${!TARGETS[@]}"; do
        code=$(probe "${TARGETS[$name]}")
        case $code in
            502|503|504|000) ok=0 ;;
            *) ok=1 ;;
        esac
        prev=${state[$name]:-1}
        if (( ok == 0 && prev == 1 )); then
            echo "FAIL $name http=$code"
            failed_since[$name]=$now
            if (( now - last_capture >= CAPTURE_MIN_GAP )); then
                last_capture=$now
                capture
            fi
        elif (( ok == 1 && prev == 0 )); then
            echo "RECOVERED $name http=$code after $(( now - failed_since[$name] ))s"
        fi
        state[$name]=$ok
    done
    sleep "$INTERVAL"
done
